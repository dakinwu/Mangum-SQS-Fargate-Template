# Copy to .env for local development (docker compose + uvicorn + worker_entry).
# ENV controls both logging format and which lifespan behaviors are active.
# local  -> colored logs, poller runs in-process if DISABLE_POLLER is unset
# dev/prod -> single-line JSON logs (for CloudWatch Logs Insights style tooling)
ENV=local

# --- Database (Postgres) ---
# API routes use a sync (psycopg2) session; the worker uses an async
# (asyncpg) session against the same database - see app/core/db.py.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=jobs

# --- SQS / LocalStack ---
# Real AWS: leave AWS_ENDPOINT_URL unset and set SQS_QUEUE_URL to the real
# queue URL. Local dev: point both at the LocalStack container started by
# docker-compose.yml (see scripts/localstack_bootstrap.sh for queue creation).
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_URL=http://localhost:4566/000000000000/jobs-queue

# --- API ---
# Set by API Gateway deployments to the stage path (e.g. "/dev") so Swagger
# UI generates correct absolute URLs. Leave empty for local uvicorn.
API_ROOT_PATH=

# --- Worker concurrency ---
MAX_CONCURRENT_TASKS=5

# --- Secrets Manager (dev/prod only; no-op locally) ---
SECRET_ARN=
